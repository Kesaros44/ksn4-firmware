/* KSN-4: KSN-1에서 왼쪽 넘패드 4열(기존 col0~3)을 제거한 18열 구성.
   왼쪽 7열(col0~6) + 오른쪽 11열(col7~17). 아래 모든 레이어는 한 행에 18개 바인딩. */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
// RGB underglow 제거됨
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/backlight.h>

/* macOS F-row 전용 커스텀 consumer usage (ZMK 코어 keys.h에 없어 직접 정의):
   - C_MISSION_CONTROL: Consumer Page(0x0C) usage 0x29F. 공식 USB HID Usage
     Tables엔 없지만 QMK가 코어 키코드로 채택했고(KC_MISSION_CONTROL, PR #19884)
     macOS가 실제로 인식하는 값.
   - C_DICTATION: Consumer Page(0x0C) usage 0xD8. 공식 USB HID Usage Tables
     HUTRR99 "Start or Stop Voice Dictation Session" 표준 usage.
   F4(Spotlight)는 전용 HID usage가 불확실해 Cmd+Space 매크로(&spotlight_macro,
   아래 behaviors 참고)로 대체. F6(방해금지모드)은 실제 macOS가 보내는 코드가
   ZMK가 지원하지 않는 Generic Desktop 페이지(usage 0x9B)라 순정 방식 구현 불가 -
   확인 후 빈 키로 유지. */
#define C_MISSION_CONTROL ZMK_HID_USAGE(HID_USAGE_CONSUMER, 0x29F)
#define C_DICTATION       ZMK_HID_USAGE(HID_USAGE_CONSUMER, 0xD8)

/ {
    behaviors {
        /* 한/영 오타 자동 되돌리기 트리거. 파라미터: 0=Windows(Ctrl+Backspace),
           1=macOS(Option+Backspace). 실제 구현은 config/src/ksn1_word_flip.c 참고. */
        word_flip: word_flip {
            compatible = "ksn,behavior-word-flip";
            #binding-cells = <1>;
        };

        inc_dec_bl: inc_dec_bl {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bl BL_INC>, <&bl BL_DEC>;
        };



        /* macOS Spotlight 검색 실행 매크로 (Cmd+Space). F4 자리 전용(mac_layer) -
           2020년 이후 최신 맥 F4가 여는 것과 동일한 화면(Spotlight)을 염. */
        spotlight_macro: spotlight_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_wait_time 100>
                , <&macro_tap &kp SPACE>
                , <&macro_release &kp LGUI>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* 오른쪽 스페이스바 우측 5키 (row5, col10~14) 배치 (2026-09-06 갱신 v2):
             LANG1(한/영)  word_flip(단어되돌리기)  mo 1(FN)  K_APP(메뉴)  LANG2(한자)
           default_layer / mac_layer 동일한 자리, param만 다름(0=Win/1=Mac).

           col12(옛 RGUI/Win 자리, 물리 스위치가 아예 없던 자리)은 한/영
           오타 자동 되돌리기용 트리거 키(&word_flip)였으나, 사용자 요청으로
           col11(FN 라벨이 있던 물리키)의 mo 1과 자리를 서로 바꿈: 이제
           col11=&word_flip, col12=&mo 2. 방금 입력한 단어를 지우고 반대
           언어로 재입력하는 동작 자체는 그대로 - 구현은
           config/src/ksn1_word_flip.c 참고.

           LANG1/LANG2는 전용 한/영·한자 키의 표준 HID usage(0x90/0x91)로,
           Windows 10 1809 이후에서 그대로 동작함. 단 macOS는 LANG1을 한/영
           전환으로 처리하지 않는다 - 일본어 JIS 가나 키(kVK_JIS_Kana)로
           해석해서 아무 일도 일어나지 않는다. Apple이 공식 문서에서 안내하는
           전환 방법은 Control+Space / Control+Option+Space / Caps Lock /
           Fn(지구본)뿐이다. 그래서 mac_layer의 col10만 &kp CLCK(Caps Lock)로
           둔다: 시스템 설정 - 키보드 - 입력 소스에서 "Caps Lock 키로 ABC 입력
           소스 전환"이 켜져 있으면, 짧게 누르면 한/영 전환 / 길게 누르면 실제
           Caps Lock으로 동작한다. mac_layer의 col14(한자, LANG2)도 같은 이유로
           macOS에서는 동작하지 않지만(맥의 한자 변환은 Option+Return),
           요청이 없어 그대로 둠.
           만약 회사 PC에서 한/영 전환이 안 되면 Windows 키보드 드라이버가
           "PC/AT 101키 호환 키보드(종류 1)"로 잡혀 있을 가능성이 큼
           (이 드라이버는 한/영=RALT, 한자=RCTRL로만 인식). 그 경우 장치
           관리자에서 "종류 3"으로 바꾸거나, col10/col14를 &kp RALT / &kp RCTRL
           로 되돌리면 됨.

           주의: 이 변경으로 오른쪽 RCTRL과 RGUI(Win) 둘 다 사라짐. Ctrl은
           왼쪽 col0(LCTRL), Win은 왼쪽 col1(LGUI)만 남음. */
        default_layer {
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
            bindings = <
                &kp ESC         &none           &kp F1          &kp F2          &kp F3          &kp F4          &kp F5          &none           &kp F6          &kp F7          &kp F8          &kp F9          &kp F10         &kp F11         &kp F12         &kp PSCRN       &kp SCROLLLOCK  &kp PAUSE_BREAK
                &kp GRAVE       &kp N1          &kp N2          &kp N3          &kp N4          &kp N5          &kp N6          &none           &kp N7          &kp N8          &kp N9          &kp N0          &kp MINUS       &kp EQUAL       &kp BSPC        &kp INS         &kp HOME        &kp PG_UP
                &kp TAB         &kp Q           &kp W           &kp E           &kp R           &kp T           &none           &kp Y           &kp U           &kp I           &kp O           &kp P           &kp LBKT        &kp RBKT        &kp BSLH        &kp DEL         &kp END         &kp PG_DN
                &kp CLCK        &kp A           &kp S           &kp D           &kp F           &kp G           &none           &kp H           &kp J           &kp K           &kp L           &kp SEMI        &kp SQT         &none           &kp RET         &none           &none           &none
                &kp LSHFT       &none           &kp Z           &kp X           &kp C           &kp V           &kp B           &kp B           &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH        &none           &kp RSHFT       &none           &kp UP          &none
                &kp LCTRL       &kp LGUI        &kp LALT        &none           &kp SPACE       &none           &none           &none           &kp SPACE       &none           &kp LANG1       &word_flip 0    &mo 2           &kp K_APP       &kp LANG2       &kp LEFT        &kp DOWN        &kp RIGHT
            >;
        };

        mac_layer {
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
            bindings = <
                &kp ESC         &none           &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_MISSION_CONTROL  &spotlight_macro  &kp C_DICTATION  &none           &none           &kp C_PREV      &kp C_PP        &kp C_NEXT      &kp C_MUTE      &kp C_VOL_DN    &kp C_VOL_UP    &kp PSCRN       &kp SCROLLLOCK  &trans
                &trans          &trans          &trans          &trans          &trans          &kp N5          &kp N6          &none           &kp N7          &kp N8          &kp N9          &kp N0          &kp MINUS       &kp EQUAL       &kp BSPC        &kp INS         &kp HOME        &kp PG_UP
                &kp TAB         &kp Q           &kp W           &kp E           &kp R           &kp T           &none           &kp Y           &kp U           &kp I           &kp O           &kp P           &kp LBKT        &kp RBKT        &kp BSLH        &kp DEL         &kp END         &kp PG_DN
                &kp CLCK        &kp A           &kp S           &kp D           &kp F           &kp G           &none           &kp H           &kp J           &kp K           &kp L           &kp SEMI        &kp SQT         &none           &kp RET         &none           &none           &none
                &kp LSHFT       &none           &kp Z           &kp X           &kp C           &kp V           &kp B           &kp B           &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH        &none           &kp RSHFT       &none           &kp UP          &none
                &kp LCTRL       &kp LALT        &kp LGUI        &none           &kp SPACE       &none           &none           &none           &kp SPACE       &none           &kp CLCK        &word_flip 1    &mo 2           &trans          &kp LANG2       &kp LEFT        &kp DOWN        &kp RIGHT
            >;
        };

        /* 레이어 순서: default(0) → mac(1) → func(2).
           func_layer를 맨 위에 두어 FN(&mo 2)을 누르면 Windows/Mac 모드와 관계없이 항상 이 레이어가
           우선한다(ZMK는 켜진 레이어 중 번호가 높은 것부터 확인). &trans 자리는 아래 레이어로 통과하므로
           FN 없이 누른 키는 그대로 mac_layer/default_layer 동작을 한다. Mac 모드 전환은 &tog 1. */
        func_layer {
            sensor-bindings = <&inc_dec_bl>;
            bindings = <
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &bt BT_CLR
                &trans          &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &out OUT_TOG    &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &tog 1          &trans          &trans          &trans          &trans
            >;
        };
    };
};
